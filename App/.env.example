# ══════════════════════════════════════════════════════════════════════════
#  Gyro Store — Plantilla de variables de entorno
# ──────────────────────────────────────────────────────────────────────────
#  Copiá este archivo como tu .env de secretos (fuera del repo, p. ej. OneDrive)
#  y apuntá la app con la variable de usuario de Windows GYRO_ENV_FILE:
#     setx GYRO_ENV_FILE "C:\Users\TuUsuario\OneDrive - Gyro Store\.env"
#  En Render: pegá cada variable en el dashboard (Settings > Environment).
# ══════════════════════════════════════════════════════════════════════════

# ── Entorno ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=

# ── Supabase (Project Settings > API) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=            # pública (frontend). No da acceso: RLS deny-all
SUPABASE_SERVICE_ROLE_KEY=    # 🔒 SECRETA. Solo backend. Ignora RLS. Nunca al frontend
SUPABASE_JWT_SECRET=          # JWT secret de Supabase (Settings > JWT Keys)

# ── Microsoft Entra ID (login del staff, vía Supabase Azure) ──
AZURE_TENANT_ID=
INTERNAL_DOMAIN=gyrostorenic.com

# ── Roles de arranque (whitelist por email; el primero es global_admin protegido) ──
# NO hay admin hardcodeado en el código: la whitelist se declara SIEMPRE por env.
ADMIN_EMAILS=
SELLER_EMAILS=
PROTECTED_ADMIN_EMAIL=

# ── Marca / negocio (se exponen vía GET /api/config) ──
BRAND_NAME=Gyro Store
CONTACT_EMAIL=
WHATSAPP_NUMBER=
CURRENCY=C$
EXCHANGE_RATE=37

# ── Cloudflare R2 (almacenamiento de imágenes) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=         # 🔒 SECRETA
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
