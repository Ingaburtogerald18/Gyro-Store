# ── Entorno ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=

# ── Supabase ──
# Project Settings > API en el dashboard de Supabase.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                 # pública (frontend). No da acceso: RLS deny-all
SUPABASE_SERVICE_ROLE_KEY=         # 🔒 SECRETA. Solo backend. Ignora RLS. Nunca al frontend

# ── Microsoft Entra ID (login del staff, vía Supabase Azure) ──
# El client id/secret se configuran en Supabase > Auth > Providers > Azure.
AZURE_TENANT_ID=
INTERNAL_DOMAIN=gyrostorenic.com

# ── Roles de arranque (whitelist por email; el primero es global_admin protegido) ──
ADMIN_EMAILS=ingaburtogerald@gmail.com
SELLER_EMAILS=
PROTECTED_ADMIN_EMAIL=

# ── Negocio (se exponen vía GET /api/config) ──
WHATSAPP_NUMBER=50585944758
CURRENCY=C$
EXCHANGE_RATE=37
